{
  "$id": "https://trading-platform/017/actor-input-event.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/ActorInputEvent",
  "definitions": {
    "ActorInputEvent": {
      "anyOf": [
        {
          "$ref": "#/definitions/MarketCandleClosedEvent"
        },
        {
          "$ref": "#/definitions/MarketOpenInterestObservedEvent"
        },
        {
          "$ref": "#/definitions/MarketLiquidationsBucketClosedEvent"
        },
        {
          "$ref": "#/definitions/MarketTakerVolumeBucketClosedEvent"
        },
        {
          "$ref": "#/definitions/MarketFundingObservedEvent"
        },
        {
          "$ref": "#/definitions/MarketSubscriptionStatusChangedEvent"
        },
        {
          "$ref": "#/definitions/ActorOrderAcceptedEvent"
        },
        {
          "$ref": "#/definitions/ActorOrderDeniedEvent"
        },
        {
          "$ref": "#/definitions/ActorOrderRejectedEvent"
        },
        {
          "$ref": "#/definitions/ActorOrderCanceledEvent"
        },
        {
          "$ref": "#/definitions/ActorOrderExpiredEvent"
        },
        {
          "$ref": "#/definitions/ActorFillEvent"
        },
        {
          "$ref": "#/definitions/ActorTimerEvent"
        }
      ],
      "description": "Замкнутый union входных событий актора."
    },
    "MarketCandleClosedEvent": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "market.candle.closed"
        },
        "bar": {
          "$ref": "#/definitions/ObservedValue%3CBar%3E"
        }
      },
      "required": [
        "kind",
        "bar"
      ],
      "additionalProperties": false,
      "description": "Закрытая (историческая) свеча по своему `subscriptionId`. Значение — `Bar` (017)."
    },
    "ObservedValue<Bar>": {
      "type": "object",
      "properties": {
        "effectiveTsUs": {
          "$ref": "#/definitions/TimestampUs"
        },
        "value": {
          "$ref": "#/definitions/Bar"
        },
        "finality": {
          "type": "string",
          "enum": [
            "provisional",
            "final"
          ]
        },
        "revision": {
          "type": "number"
        }
      },
      "required": [
        "effectiveTsUs",
        "value",
        "finality",
        "revision"
      ],
      "additionalProperties": false,
      "description": "Наблюдённое значение с собственной временной координатой.\n\n`effectiveTsUs` — бизнес-минута T, к которой значение относится; `finality` и `revision` ортогональны (§3.11.3): тройка `provisional / final / revised` была ошибкой моделирования, потому что ревизованное значение само либо provisional, либо final.\n\nВ v1 законна ровно одна комбинация — `final` / `0`; resolver отвергает поток с ревизиями fail-closed. Поля входят в форму сразу, чтобы позднее добавление ревизий не ломало форму события."
    },
    "TimestampUs": {
      "type": "number",
      "description": "Момент времени в микросекундах эпохи. Целое, неотрицательное, safe-integer."
    },
    "Bar": {
      "type": "object",
      "properties": {
        "ts": {
          "type": "number"
        },
        "open": {
          "type": "number"
        },
        "high": {
          "type": "number"
        },
        "low": {
          "type": "number"
        },
        "close": {
          "type": "number"
        },
        "volume": {
          "type": "number"
        }
      },
      "required": [
        "ts",
        "open",
        "high",
        "low",
        "close",
        "volume"
      ],
      "additionalProperties": false,
      "description": "Закрытая (исторически завершённая) свеча."
    },
    "MarketOpenInterestObservedEvent": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "market.open_interest.observed"
        },
        "oi": {
          "$ref": "#/definitions/ObservedValue%3COiPoint%3E"
        }
      },
      "required": [
        "kind",
        "oi"
      ],
      "additionalProperties": false,
      "description": "Open interest — **point observation**: `oi.value` есть УРОВЕНЬ на момент `oi.effectiveTsUs`, а не приращение с прошлого наблюдения (в отличие от liq/taker-бакетов ниже, которые суммируют события ВНУТРИ интервала)."
    },
    "ObservedValue<OiPoint>": {
      "type": "object",
      "properties": {
        "effectiveTsUs": {
          "$ref": "#/definitions/TimestampUs"
        },
        "value": {
          "$ref": "#/definitions/OiPoint"
        },
        "finality": {
          "type": "string",
          "enum": [
            "provisional",
            "final"
          ]
        },
        "revision": {
          "type": "number"
        }
      },
      "required": [
        "effectiveTsUs",
        "value",
        "finality",
        "revision"
      ],
      "additionalProperties": false,
      "description": "Наблюдённое значение с собственной временной координатой.\n\n`effectiveTsUs` — бизнес-минута T, к которой значение относится; `finality` и `revision` ортогональны (§3.11.3): тройка `provisional / final / revised` была ошибкой моделирования, потому что ревизованное значение само либо provisional, либо final.\n\nВ v1 законна ровно одна комбинация — `final` / `0`; resolver отвергает поток с ревизиями fail-closed. Поля входят в форму сразу, чтобы позднее добавление ревизий не ломало форму события."
    },
    "OiPoint": {
      "type": "object",
      "properties": {
        "ts": {
          "type": "number"
        },
        "oiTotalUsd": {
          "type": "number"
        }
      },
      "required": [
        "ts",
        "oiTotalUsd"
      ],
      "additionalProperties": false,
      "description": "Точка OI as-of минуты (read-only)."
    },
    "MarketLiquidationsBucketClosedEvent": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "market.liquidations.bucket_closed"
        },
        "liq": {
          "$ref": "#/definitions/ObservedValue%3CLiqPoint%3E"
        }
      },
      "required": [
        "kind",
        "liq"
      ],
      "additionalProperties": false,
      "description": "Ликвидации — **interval aggregate** за закрытый бакет своего `subscriptionId`."
    },
    "ObservedValue<LiqPoint>": {
      "type": "object",
      "properties": {
        "effectiveTsUs": {
          "$ref": "#/definitions/TimestampUs"
        },
        "value": {
          "$ref": "#/definitions/LiqPoint"
        },
        "finality": {
          "type": "string",
          "enum": [
            "provisional",
            "final"
          ]
        },
        "revision": {
          "type": "number"
        }
      },
      "required": [
        "effectiveTsUs",
        "value",
        "finality",
        "revision"
      ],
      "additionalProperties": false,
      "description": "Наблюдённое значение с собственной временной координатой.\n\n`effectiveTsUs` — бизнес-минута T, к которой значение относится; `finality` и `revision` ортогональны (§3.11.3): тройка `provisional / final / revised` была ошибкой моделирования, потому что ревизованное значение само либо provisional, либо final.\n\nВ v1 законна ровно одна комбинация — `final` / `0`; resolver отвергает поток с ревизиями fail-closed. Поля входят в форму сразу, чтобы позднее добавление ревизий не ломало форму события."
    },
    "LiqPoint": {
      "type": "object",
      "properties": {
        "ts": {
          "type": "number"
        },
        "longUsd": {
          "type": "number"
        },
        "shortUsd": {
          "type": "number"
        }
      },
      "required": [
        "ts",
        "longUsd",
        "shortUsd"
      ],
      "additionalProperties": false,
      "description": "Точка liquidations as-of минуты (read-only). Покрытая-без-событий → {0,0}."
    },
    "MarketTakerVolumeBucketClosedEvent": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "market.taker_volume.bucket_closed"
        },
        "taker": {
          "$ref": "#/definitions/ObservedValue%3CTakerReading%3E"
        }
      },
      "required": [
        "kind",
        "taker"
      ],
      "additionalProperties": false,
      "description": "Taker-объём — **interval aggregate** за закрытый минутный бакет своего `subscriptionId`."
    },
    "ObservedValue<TakerReading>": {
      "type": "object",
      "properties": {
        "effectiveTsUs": {
          "$ref": "#/definitions/TimestampUs"
        },
        "value": {
          "$ref": "#/definitions/TakerReading"
        },
        "finality": {
          "type": "string",
          "enum": [
            "provisional",
            "final"
          ]
        },
        "revision": {
          "type": "number"
        }
      },
      "required": [
        "effectiveTsUs",
        "value",
        "finality",
        "revision"
      ],
      "additionalProperties": false,
      "description": "Наблюдённое значение с собственной временной координатой.\n\n`effectiveTsUs` — бизнес-минута T, к которой значение относится; `finality` и `revision` ортогональны (§3.11.3): тройка `provisional / final / revised` была ошибкой моделирования, потому что ревизованное значение само либо provisional, либо final.\n\nВ v1 законна ровно одна комбинация — `final` / `0`; resolver отвергает поток с ревизиями fail-closed. Поля входят в форму сразу, чтобы позднее добавление ревизий не ломало форму события."
    },
    "TakerReading": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "present"
            },
            "point": {
              "$ref": "#/definitions/TakerPoint"
            }
          },
          "required": [
            "state",
            "point"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "stale"
            }
          },
          "required": [
            "state"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "missing"
            }
          },
          "required": [
            "state"
          ],
          "additionalProperties": false
        }
      ],
      "description": "030 — taker reading за минутный бакет `[t, t+60s)`. **3-state** (`present|stale|missing`); `unsupported` — НЕ reading-состояние. `present` несёт raw `{buyUsd,sellUsd}` (вкл. present-zero `{0,0}`); `stale` — незавершённый бакет (point НЕ несётся, без carry-forward); `missing` — gap (не ноль)."
    },
    "TakerPoint": {
      "type": "object",
      "properties": {
        "ts": {
          "type": "number"
        },
        "buyUsd": {
          "type": "number"
        },
        "sellUsd": {
          "type": "number"
        }
      },
      "required": [
        "ts",
        "buyUsd",
        "sellUsd"
      ],
      "additionalProperties": false,
      "description": "030 — точка raw taker flow за минутный бакет (read-only). delta = `buyUsd − sellUsd` (derived)."
    },
    "MarketFundingObservedEvent": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "market.funding.observed"
        },
        "funding": {
          "$ref": "#/definitions/ObservedValue%3CFundingReading%3E"
        }
      },
      "required": [
        "kind",
        "funding"
      ],
      "additionalProperties": false,
      "description": "Funding: rate либо settlement — различаются явно через `FundingReading`/`FundingPoint` (030), а не отдельными `kind` этой задачи. Расщепление «периодический rate-тик» vs «settlement-выплата на границе интервала» — по значению `fundingRate`/`ts` в уже существующем типе, не по форме события: заводить здесь новый value-тип означало бы проектировать его заново, а задача просит ровно `FundingReading` из `market-tape.js`."
    },
    "ObservedValue<FundingReading>": {
      "type": "object",
      "properties": {
        "effectiveTsUs": {
          "$ref": "#/definitions/TimestampUs"
        },
        "value": {
          "$ref": "#/definitions/FundingReading"
        },
        "finality": {
          "type": "string",
          "enum": [
            "provisional",
            "final"
          ]
        },
        "revision": {
          "type": "number"
        }
      },
      "required": [
        "effectiveTsUs",
        "value",
        "finality",
        "revision"
      ],
      "additionalProperties": false,
      "description": "Наблюдённое значение с собственной временной координатой.\n\n`effectiveTsUs` — бизнес-минута T, к которой значение относится; `finality` и `revision` ортогональны (§3.11.3): тройка `provisional / final / revised` была ошибкой моделирования, потому что ревизованное значение само либо provisional, либо final.\n\nВ v1 законна ровно одна комбинация — `final` / `0`; resolver отвергает поток с ревизиями fail-closed. Поля входят в форму сразу, чтобы позднее добавление ревизий не ломало форму события."
    },
    "FundingReading": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "present"
            },
            "point": {
              "$ref": "#/definitions/FundingPoint"
            }
          },
          "required": [
            "state",
            "point"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "stale"
            },
            "point": {
              "$ref": "#/definitions/FundingPoint"
            }
          },
          "required": [
            "state",
            "point"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "missing"
            }
          },
          "required": [
            "state"
          ],
          "additionalProperties": false
        }
      ],
      "description": "030 — freshness-aware funding reading для текущей закрытой минуты `t`. **3-state** (`present|stale|missing`); `unsupported` — НЕ reading-состояние (выражается через отсутствие метода + coverage). `present`/`stale` несут реальный снимок (`ts ≤ t`); `stale` = bounded live-forward (FR-007), НЕ запрещённый carry-forward. `missing` — нет снимка `ts ≤ t` (не подменяется нулём)."
    },
    "FundingPoint": {
      "type": "object",
      "properties": {
        "ts": {
          "type": "number"
        },
        "fundingRate": {
          "type": "number"
        }
      },
      "required": [
        "ts",
        "fundingRate"
      ],
      "additionalProperties": false,
      "description": "030 — точка funding as-of минуты (read-only). `ts` реального снимка, `ts ≤ t` (возраст = `t − ts`)."
    },
    "MarketSubscriptionStatusChangedEvent": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "market.subscription.status_changed"
        },
        "status": {
          "type": "string",
          "const": "gap"
        },
        "expectedTsUs": {
          "$ref": "#/definitions/TimestampUs"
        }
      },
      "required": [
        "kind",
        "status",
        "expectedTsUs"
      ],
      "additionalProperties": false,
      "description": "Изменение статуса подписки на `'gap'`. `expectedTsUs` — первая ожидаемая, но не пришедшая точка (frontier, на котором обнаружен пропуск), не момент детекции (тот — `eventTsUs` конверта)."
    },
    "ActorOrderAcceptedEvent": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "order.accepted"
        },
        "ts": {
          "type": "number"
        },
        "clientOrderId": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "ts",
        "clientOrderId"
      ],
      "additionalProperties": false,
      "description": "Заявка принята средой (venue/симулятором)."
    },
    "ActorOrderDeniedEvent": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "order.denied"
        },
        "ts": {
          "type": "number"
        },
        "clientOrderId": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "ts",
        "clientOrderId",
        "reason"
      ],
      "additionalProperties": false,
      "description": "Заявка отклонена ЛОКАЛЬНО, до среды: RiskEngine (кламп не спас — потолок, rate-limit, price-band, reduce-only в REDUCING). Терминальный. Отличим от `order.rejected` намеренно."
    },
    "ActorOrderRejectedEvent": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "order.rejected"
        },
        "ts": {
          "type": "number"
        },
        "clientOrderId": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "ts",
        "clientOrderId",
        "reason"
      ],
      "additionalProperties": false,
      "description": "Заявка отклонена СРЕДОЙ (venue/симулятор). Терминальный."
    },
    "ActorOrderCanceledEvent": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "order.canceled"
        },
        "ts": {
          "type": "number"
        },
        "clientOrderId": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "ts",
        "clientOrderId"
      ],
      "additionalProperties": false,
      "description": "Заявка отменена (по команде `cancel` либо средой). Терминальный."
    },
    "ActorOrderExpiredEvent": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "order.expired"
        },
        "ts": {
          "type": "number"
        },
        "clientOrderId": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "ts",
        "clientOrderId"
      ],
      "additionalProperties": false,
      "description": "Заявка истекла по TIF/сроку. Терминальный."
    },
    "ActorFillEvent": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "fill"
        },
        "ts": {
          "type": "number"
        },
        "clientOrderId": {
          "type": "string"
        },
        "price": {
          "type": "number"
        },
        "qty": {
          "type": "number",
          "description": "Исполненный размер в базовой валюте инструмента."
        },
        "fee": {
          "type": "number"
        },
        "last": {
          "type": "boolean",
          "description": "Последний филл заявки (заявка перешла в терминальный `filled`)."
        }
      },
      "required": [
        "kind",
        "ts",
        "clientOrderId",
        "price",
        "qty",
        "fee",
        "last"
      ],
      "additionalProperties": false,
      "description": "Исполнение (полное либо частичное — различает `last`). Инвариант state-before-handler: `ctx.position()`/`ctx.orders.open()` УЖЕ учитывают этот филл к моменту вызова хендлера."
    },
    "ActorTimerEvent": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "timer"
        },
        "ts": {
          "type": "number"
        },
        "timerId": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "ts",
        "timerId"
      ],
      "additionalProperties": false,
      "description": "Срабатывание таймера, поставленного командой `timer.set`. Таймерами владеет ХОСТ: у изолята нет часов. В backtest/paper время двигают бары, в live дополнительно wall-clock-тик — business_ts события в обоих случаях из ленты, нового недетерминизма нет."
    }
  },
  "title": "ActorInputEvent"
}
